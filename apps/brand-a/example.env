# Shared across all 3 brand apps — same Shopify instance
SHOPIFY_STORE_DOMAIN=shuto-development-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZE_ENDPOINT=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_ENDPOINT=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_ENDPOINT=
SHOPIFY_CUSTOMER_API_VERSION=2026-07

# Optional — omit to fall back to the cookie-backed mock driver for custom.brand / custom.favourites
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07

# Per-app — generate with: openssl rand -base64 32
SESSION_SECRET=
# Rename this file to .env.local (and fill in the blanks) to run the app.
